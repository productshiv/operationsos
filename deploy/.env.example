# Copy to deploy/.env (or set these in Coolify's env). Never commit the real .env.
#
# Postgres credentials are fixed inside docker-compose.yml (internal DB, not exposed),
# so there's nothing to set for the database here.

# Public URL where this stack is reachable, with /tf appended (the harness is
# proxied under /tf). Used for MCP OAuth callbacks.
#   e.g. https://operationsos.yourdomain.com/tf
PUBLIC_BASE_URL=http://localhost:8080/tf

# Host port for the web app (nginx) — LOCAL ONLY (docker-compose.override.yml).
# Coolify ignores this and routes your domain to the web service's internal port 80.
WEB_PORT=8080
